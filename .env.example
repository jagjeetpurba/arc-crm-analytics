# --- backend ---
ERP_MODE=local                 # local (SQLite stand-in) | airgen
AIRGEN_BASE_URL=               # e.g. https://<tenant>.airgen.ai/api/erp   (confirm in console)
AIRGEN_API_KEY=                # READ-ONLY key scoped to the analytics objects
WRITE_API_KEY=change-me        # required header X-API-Key on /api/sync/heal, /api/ingest/*, /api/audit, /api/snapshots/*
AS_OF=                         # optional ISO date; default = latest date in the data
WATCH_INTERVAL_S=15            # fallback ERP poller; 0 disables (rely on the Airgen healing agent only)
CORS_ORIGINS=http://localhost:5173
